# Copy this file to deploy/portable/.env.production and replace every CHANGE_ME value.
# Never commit the populated .env.production file.

# Certified immutable application release
CATORA_PRODUCTION_RELEASE_GIT_SHA=89f0d6334adffa5a680dca0334f2aa4b6e51e981
CATORA_PRODUCTION_RELEASE_CI_RUN_ID=31639609924
CATORA_PRODUCTION_API_IMAGE_DIGEST=sha256:f5d64a7b4caa3bf1f9743cdd20b0733d14ff96df267bd98a49d2979635476b1d
CATORA_PRODUCTION_WORKER_IMAGE_DIGEST=sha256:f6b3c96990507971148d174e924d2dadff66833aedcd63308f219dd3adf6c90c
CATORA_PRODUCTION_WEB_IMAGE_DIGEST=sha256:d42c7d5676714c9dd1ca9e6ebec5c84b3af53a58b3e20058cbc8504ad78da2e7
CATORA_PRODUCTION_API_PREVIOUS_IMAGE=none
CATORA_PRODUCTION_WORKER_PREVIOUS_IMAGE=none
CATORA_PRODUCTION_WEB_PREVIOUS_IMAGE=none
CATORA_PRODUCTION_API_BIND=127.0.0.1
CATORA_PRODUCTION_WEB_BIND=127.0.0.1
CATORA_PRODUCTION_INTERNAL_API_URL=http://api:8000
CATORA_PRODUCTION_ENV_FILE=.env.production

# Core production runtime
CATORA_ENVIRONMENT=production
CATORA_LOG_LEVEL=INFO
CATORA_FRONTEND_URL=https://catora.codistan.org
CATORA_CORS_ORIGINS=["https://catora.codistan.org"]
CATORA_TRUST_PROXY_HEADERS=true
CATORA_ENRICHMENT_PROVIDER=disabled
CATORA_AUTH_TOKEN_PEPPER=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# The dependency overlay supplies database/Redis/S3 runtime URLs to API/worker/migrate.
CATORA_SELF_HOSTED_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_PASSWORD
CATORA_SELF_HOSTED_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
CATORA_SELF_HOSTED_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
CATORA_SELF_HOSTED_S3_BUCKET=catora

# WordPress Service Visibility: enabled for the Hilarious lighthouse workflow.
CATORA_SERVICE_VISIBILITY_ENABLED=true
CATORA_SERVICE_VISIBILITY_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_URLSAFE_BASE64_32_BYTE_KEY
CATORA_SERVICE_VISIBILITY_DRAFTS_ENABLED=true
CATORA_SERVICE_VISIBILITY_MONITORING_ENABLED=true

# Search Console / GA4 UI and sync support. Add the managed Google credential later.
CATORA_MEASUREMENT_CONNECTORS_ENABLED=true

# Keep unrelated connectors disabled until their production credentials are deliberately configured.
CATORA_CATALOG_BRIDGE_ENABLED=false
CATORA_RESTAURANT_DOMAIN_ENABLED=false
CATORA_LOCAL_PROFILE_INTELLIGENCE_ENABLED=false
CATORA_REPUTATION_INTELLIGENCE_ENABLED=false
CATORA_AUTHORITY_INTELLIGENCE_ENABLED=false
CATORA_RESTAURANT_OPERATIONS_CONSOLE_ENABLED=false
CATORA_RESTAURANT_MONITORING_ENABLED=false
CATORA_RESTAURANT_PILOT_ACCEPTANCE_ENABLED=false
CATORA_SHOPIFY_ENABLED=false
CATORA_SHOPIFY_PUBLIC_ENABLED=false

# Optional email delivery. Configure a real SMTP endpoint before relying on password-reset mail.
# CATORA_SMTP_HOST=
# CATORA_SMTP_PORT=587
# CATORA_SMTP_FROM=Catora <no-reply@your-domain.example>

# Later, when Google measurement is connected, inject this only through the protected runtime env:
# CATORA_GOOGLE_MEASUREMENT_SERVICE_ACCOUNT_JSON={...}
