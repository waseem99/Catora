# Shared
CATORA_ENVIRONMENT=development
CATORA_LOG_LEVEL=INFO

# API
CATORA_API_URL=http://localhost:8000
NEXT_PUBLIC_CATORA_API_URL=http://localhost:8000
CATORA_DATABASE_URL=postgresql+asyncpg://catora:catora@localhost:5432/catora
CATORA_REDIS_URL=redis://localhost:6379/0
CATORA_S3_ENDPOINT_URL=http://localhost:9000
CATORA_S3_ACCESS_KEY=catora
CATORA_S3_SECRET_KEY=change-me-in-production
CATORA_S3_BUCKET=catora
CATORA_MAX_CATALOG_UPLOAD_BYTES=26214400
CATORA_CORS_ORIGINS=["http://localhost:3000"]

# Authentication
CATORA_AUTH_TOKEN_PEPPER=development-token-pepper-change-me
CATORA_FRONTEND_URL=http://localhost:3000
CATORA_SMTP_HOST=localhost
CATORA_SMTP_PORT=1025
CATORA_SMTP_FROM=Catora <no-reply@catora.local>

# Push-only connector for custom Node.js/MongoDB commerce projects
CATORA_CATALOG_BRIDGE_ENABLED=false
# URL-safe base64 encoding of exactly 32 random bytes; keep separate from Shopify keys.
CATORA_CATALOG_BRIDGE_CREDENTIAL_ENCRYPTION_KEY=
CATORA_CATALOG_BRIDGE_CLOCK_SKEW_SECONDS=300
CATORA_CATALOG_BRIDGE_MAX_BATCH_BYTES=5242880

# WordPress service visibility intelligence
CATORA_SERVICE_VISIBILITY_ENABLED=false
# URL-safe base64 encoding of exactly 32 random bytes; keep separate from other connector keys.
CATORA_SERVICE_VISIBILITY_CREDENTIAL_ENCRYPTION_KEY=
CATORA_SERVICE_VISIBILITY_CLOCK_SKEW_SECONDS=300
CATORA_SERVICE_VISIBILITY_MAX_BATCH_BYTES=5242880
# Drafts always create unpublished WordPress copies and require explicit approval.
CATORA_SERVICE_VISIBILITY_DRAFTS_ENABLED=false
# Enable only after a recurring monitoring customer has approved the schedule.
CATORA_SERVICE_VISIBILITY_MONITORING_ENABLED=false

# Restaurant and multi-location intelligence; all modules default off.
CATORA_RESTAURANT_DOMAIN_ENABLED=false
# Only the synthetic local-profile provider is available until an account-level provider acceptance exists.
CATORA_LOCAL_PROFILE_INTELLIGENCE_ENABLED=false
# Review observations and drafts remain synthetic/read-only; Catora never posts provider responses.
CATORA_REPUTATION_INTELLIGENCE_ENABLED=false

# Controlled Shopify custom-distribution pilot app
CATORA_SHOPIFY_ENABLED=false
CATORA_SHOPIFY_CLIENT_ID=
CATORA_SHOPIFY_CLIENT_SECRET=
CATORA_SHOPIFY_CALLBACK_URL=http://localhost:8000/api/v1/shopify/oauth/callback
CATORA_SHOPIFY_REQUIRED_SCOPES=["read_products"]
CATORA_SHOPIFY_EXPIRING_OFFLINE_TOKENS=true
CATORA_SHOPIFY_OAUTH_STATE_TTL_MINUTES=10
# URL-safe base64 encoding of exactly 32 random bytes.
CATORA_SHOPIFY_CREDENTIAL_ENCRYPTION_KEY=
CATORA_SHOPIFY_HTTP_TIMEOUT_SECONDS=30

# Embedded public-distribution Shopify app
CATORA_SHOPIFY_PUBLIC_ENABLED=false
# Use public_production only in the production runtime.
CATORA_SHOPIFY_PUBLIC_REGISTRATION_IDENTITY=public_development
# Set false to pause first-time activations without disrupting existing stores.
CATORA_SHOPIFY_PUBLIC_NEW_ACTIVATIONS_ENABLED=true
CATORA_SHOPIFY_PUBLIC_CLIENT_ID=
CATORA_SHOPIFY_PUBLIC_CLIENT_SECRET=
CATORA_SHOPIFY_PUBLIC_APP_URL=http://localhost:3001
CATORA_SHOPIFY_PUBLIC_REQUIRED_SCOPES=["read_products"]
# Use a separate URL-safe base64 encoding of exactly 32 random bytes.
CATORA_SHOPIFY_PUBLIC_CREDENTIAL_ENCRYPTION_KEY=
CATORA_SHOPIFY_PUBLIC_HTTP_TIMEOUT_SECONDS=30
CATORA_SHOPIFY_PUBLIC_SESSION_CLOCK_SKEW_SECONDS=5
